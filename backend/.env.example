# Database (Supabase / PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db

# JWT Secrets (minimum 10 characters each)
JWT_ACCESS_SECRET=your_super_secret_access_key_min_10_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_10_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (Resend) - Optional
RESEND_API_KEY=
EMAIL_FROM="StockSense <onboarding@resend.dev>"
