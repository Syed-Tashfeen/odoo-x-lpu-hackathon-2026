{
  "name": "hackathon-backend",
  "version": "1.0.0",
  "description": "StockSense Backend — Express + TS + Drizzle + Zod + Swagger",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
